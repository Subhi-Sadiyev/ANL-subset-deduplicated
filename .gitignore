# EDA near-duplicate artifacts
/near_duplicate_data_eda/near_duplicate_features/*
!/near_duplicate_data_eda/near_duplicate_features/.gitkeep

/near_duplicate_data_eda/near_duplicate_pairs/*
!/near_duplicate_data_eda/near_duplicate_pairs/.gitkeep

